# Telegram user account (my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
TG_SESSION=booking_agent          # session file name, created by `python run.py login`

# Where the agent asks for facts it doesn't know: console | me (Saved Messages) | @owner_username
OWNER_CHANNEL=console
OWNER_TIMEOUT_SECONDS=900
DEBOUNCE_SECONDS=4                # wait for a burst of manager messages before answering

# LLM: codex (Codex CLI on a ChatGPT subscription) | openai (any OpenAI-compatible endpoint)
LLM_BACKEND=codex
CODEX_BIN=codex
CODEX_MODEL=
CODEX_REASONING=low
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Voice: off | mirror (answer voice with voice) | always
VOICE_MODE=mirror
TTS_VOICE=en-GB-RyanNeural
WHISPER_MODEL=small
WHISPER_DEVICE=cpu        # cuda if CUDA 12 + cuDNN are installed

# The real manager: writing to them requires --live
PROTECTED_TARGET=vlad_dev_7

# Telegram user account (my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
TG_SESSION=booking_agent          # session file name, created by `python run.py login`

# autonomous: the owner is busy, the agent acts within owner_profile.json and never waits
# ask: things outside the profile are asked from the owner, the agent waits OWNER_TIMEOUT_SECONDS
OWNER_MODE=autonomous
# Where the owner gets the final report (and questions in ask mode): none | console | me (Saved Messages) | @username
OWNER_CHANNEL=me
OWNER_TIMEOUT_SECONDS=180
SILENCE_FOLLOWUP_MINUTES=5         # manager quiet this long: one polite follow-up
SILENCE_GIVEUP_MINUTES=20          # still quiet: report to the owner (agent keeps listening)
DEBOUNCE_SECONDS=4                # wait for a burst of manager messages before answering

# LLM: codex (Codex CLI on a ChatGPT subscription) | openai (any OpenAI-compatible endpoint)
LLM_BACKEND=codex
CODEX_BIN=codex
CODEX_MODEL=gpt-6.2-sol
CODEX_REASONING=low
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60

# Abuse limits (manager text is untrusted; enforced in code, the model cannot lift them)
MAX_LLM_CALLS=40
MAX_INCOMING_CHARS=800
MAX_VOICE_SECONDS=90
MAX_REPLY_CHARS=450
HISTORY_TURNS=30

# Voice: off | mirror (answer voice with voice) | always
VOICE_MODE=mirror
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+0%
WHISPER_MODEL=small
WHISPER_DEVICE=cpu        # cuda if CUDA 12 + cuDNN are installed

# The real manager: writing to them requires --live
PROTECTED_TARGET=vlad_dev_7
